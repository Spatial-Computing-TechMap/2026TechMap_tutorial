@Tutorial(time: 20) {
    @Intro(title: "태양과 조명") {
        **이번 챕터에서 배우는 것**: 3D 모델을 패키지에서 불러와 공간에 놓고, 장면 전체를
        비추는 빛을 직접 만듭니다.

        **완성하면**: 별이 가득한 공간 한가운데에 태양이 떠서 주변을 밝힙니다.

        @Image(source: "app-sun.png", alt: "우주 공간에 떠 있는 태양")
    }

    @Section(title: "3D 에셋 패키지 이해하기") {
        @ContentAndMedia {
            첫 챕터에서 연결한 3D 모델은 `Packages/SolarSystemAssets`라는
            별도의 로컬 Swift 패키지에 들어 있습니다.

            모델을 패키지로 따로 떼어 두면 두 가지가 좋습니다. 첫째, 용량이 큰 에셋이 앱 코드와
            섞이지 않습니다. 둘째, Reality Composer Pro로 그 패키지만 열어 모델을 편집할 수 있습니다.

            @Image(source: "diagram-package.svg", alt: "3D 에셋 패키지의 구조")
        }

        @Steps {
            @Step {
                Xcode 왼쪽 파일 목록에서 `Package Dependencies > SolarSystemAssets`를 펼쳐 구조를 살펴봅니다.
                `Sources/SolarSystemAssets/SolarSystemAssets.rkassets` 폴더 안에 모든 모델이 들어 있습니다.

            }

            @Step {
                `SolarSystemAssets.swift` 파일을 엽니다. 여기 있는
                `solarSystemAssetsBundle`이 이 패키지의 에셋 묶음을 가리킵니다.

                모델을 불러올 때 `Entity(named:in:)`의 `in:`에 이 값을 넘깁니다.

            }

            @Step {
                앱 타깃이 이 패키지를 쓰도록 연결되어 있는지 확인합니다. 프로젝트 설정의
                **General > Frameworks, Libraries, and Embedded Content** 목록에
                `SolarSystemAssets`가 있어야 합니다.

                > Note: 첫 챕터에서 Add Local로 연결한 패키지입니다. 목록에 없다면 앱 타깃에 패키지 제품을 추가하세요.

            }
        }
    }

    @Section(title: "태양 모델 불러오기") {
        @ContentAndMedia {
            모델을 불러오는 일은 시간이 걸리는 작업입니다. 그래서 `await`을 붙여 기다립니다.

            불러온 뒤에는 크기와 위치를 정해 줘야 합니다. 모델은 만들어질 때 정해진 크기를
            가지고 있는데, 그대로 쓰면 장면에 비해 너무 크거나 작은 경우가 많습니다.

        }

        @Steps {
            @Step {
                `RealityViews` 그룹에 `Sun.swift` 파일을 만듭니다.

                `RealityView`의 첫 번째 블록은 화면이 만들어질 때 한 번 실행되고,
                `update:` 블록은 바깥에서 값이 바뀔 때마다 다시 실행됩니다.

                @Code(name: "Sun.swift", file: "02-01-Sun.swift")
            }

            @Step {
                `AppModel`에 태양의 위치와 크기를 추가합니다.

                위치는 미터 단위입니다. `z`가 음수면 사람의 앞쪽, `y`가 양수면 위쪽입니다.
                여기서는 눈높이보다 조금 아래, 9미터 앞에 둡니다.

                @Code(name: "AppModel.swift", file: "02-03-AppModel.swift", previousFile: "01-02-AppModel.swift")
            }

            @Step {
                `SolarSystem`에 태양을 넣습니다. 별 배경 위에 태양이 겹쳐 보입니다.

                @Code(name: "SolarSystem.swift", file: "02-04-SolarSystem.swift", previousFile: "01-06-SolarSystem.swift")
            }

            @Step {
                실행해 봅니다. 태양이 보이긴 하지만 어둡고 밋밋합니다. 빛이 없기 때문입니다.

            }
        }
    }

    @Section(title: "장면에 빛 넣기") {
        @ContentAndMedia {
            창이나 혼합 몰입 공간에서는 시스템이 주변 밝기에 맞춰 조명을 자동으로 넣어 줍니다.
            하지만 **전체 몰입 공간에는 기본 조명이 없습니다**. 앱이 만든 공간이 곧 전부이기
            때문에, 빛도 앱이 직접 만들어야 합니다.

            태양처럼 한 점에서 사방으로 퍼지는 빛은 `PointLightComponent`로 만듭니다.
            전구를 하나 매달아 두는 것과 같습니다.

            @Image(source: "diagram-light.svg", alt: "태양 위치에서 빛이 퍼져 나가는 모습")
        }

        @Steps {
            @Step {
                `Sun`에 빛 엔티티를 추가합니다.

                빛을 태양 모델의 자식으로 붙이지 않고 따로 두는 점에 주의하세요. 자식으로 붙이면
                모델을 두 배로 키울 때 빛이 닿는 거리도 함께 두 배가 되어, 밝기를 조절하기
                어려워집니다.

                @Code(name: "Sun.swift", file: "02-02-Sun.swift", previousFile: "02-01-Sun.swift")
            }

            @Step {
                `intensity`는 빛의 세기, `attenuationRadius`는 빛이 닿는 거리입니다.
                여기서는 60미터로 넉넉히 잡아, 나중에 만들 가장 바깥 행성까지 빛이 닿게 합니다.

                @Code(name: "Sun.swift", file: "02-02-Sun.swift")
            }

            @Step {
                다시 실행합니다. 태양이 또렷하게 보이고, 주변을 밝히는 빛이 생겼습니다.

                > Note: 이 챕터까지도 시뮬레이터만으로 확인할 수 있습니다.

                @Image(source: "app-sun.png", alt: "조명이 들어온 태양")
            }
        }
    }

    @Section(title: "막히면 확인하세요") {
        @ContentAndMedia {
            이 챕터에서 자주 겪는 문제입니다.

        }

        @Steps {
            @Step {
                **태양이 전혀 보이지 않습니다.** `entity(named:)`가 `nil`을 돌려줬을 수 있습니다.
                `Sun.usda`와 `Sun` 폴더를 함께 넣었는지, 이름의 철자와 대소문자가 맞는지 확인하세요.
            }

            @Step {
                **모든 것이 새까맣게 보입니다.** 빛을 넣지 않았거나, 빛의 `attenuationRadius`가
                너무 짧아 물체까지 닿지 않는 경우입니다. 거리를 늘려 보세요.
            }

            @Step {
                **태양이 너무 크거나 작습니다.** 모델마다 원래 크기가 다릅니다.
                `solarSunScale` 값을 바꿔 가며 맞추세요. 값을 바꾸면 `update:` 블록이 실행되어
                즉시 반영됩니다.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            전체 몰입 공간에서 빛을 직접 넣어야 하는 이유는 무엇일까요?

            @Choice(isCorrect: false) {
                RealityKit이 조명 기능을 지원하지 않기 때문입니다.

                @Justification {
                    RealityKit은 여러 종류의 조명을 지원합니다. 다만 기본으로 켜 주지 않을 뿐입니다.
                }
            }

            @Choice(isCorrect: true) {
                주변 현실이 완전히 가려져서, 앱이 만든 빛 외에는 아무 빛도 없기 때문입니다.

                @Justification {
                    맞습니다. 창이나 혼합 몰입 공간에서는 주변 환경의 밝기를 바탕으로 조명이 자동으로 들어옵니다.
                }
            }

            @Choice(isCorrect: false) {
                시뮬레이터에서만 조명이 꺼지기 때문입니다.

                @Justification {
                    실기기에서도 마찬가지입니다. 전체 몰입 공간에는 기본 조명이 없습니다.
                }
            }
        }

        @MultipleChoice {
            빛 엔티티를 태양 모델의 자식으로 붙이지 않은 이유는 무엇일까요?

            @Choice(isCorrect: false) {
                자식 엔티티에는 조명 컴포넌트를 붙일 수 없기 때문입니다.

                @Justification {
                    자식 엔티티에도 조명을 붙일 수 있습니다. 문제는 크기가 함께 적용된다는 점입니다.
                }
            }

            @Choice(isCorrect: true) {
                모델의 크기를 바꾸면 빛이 닿는 거리도 함께 바뀌어, 밝기를 따로 조절하기 어렵기 때문입니다.

                @Justification {
                    맞습니다. 부모의 `scale`은 자식의 모든 값에 영향을 줍니다.
                }
            }

            @Choice(isCorrect: false) {
                빛과 모델은 서로 다른 RealityView에 있어야 하기 때문입니다.

                @Justification {
                    같은 RealityView 안에 함께 둘 수 있습니다. 부모-자식으로 묶지 않았을 뿐입니다.
                }
            }
        }
    }
}
