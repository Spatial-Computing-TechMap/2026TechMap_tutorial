@Tutorial(time: 20) {
    @Intro(title: "창과 몰입 공간 만들기") {
        **이번 챕터에서 배우는 것**: 창에서 몰입 공간을 여닫고, 별이 가득한 우주 배경을 띄웁니다.

        **완성하면**: 창의 버튼을 눌렀을 때 주변이 온통 별로 둘러싸인 우주로 바뀝니다.

        @Image(source: "app-starfield.png", alt: "별이 가득한 우주 공간")
    }

    @Section(title: "앱 상태를 담을 모델 만들기") {
        @ContentAndMedia {
            창과 몰입 공간은 서로 다른 화면이지만 같은 정보를 봐야 합니다. 창의 버튼은 몰입 공간이
            열려 있는지 알아야 하고, 몰입 공간은 자신이 열렸다는 사실을 창에 알려야 합니다.

            이런 공유 상태는 `@Observable` 클래스 하나에 모아 두고, SwiftUI의 환경을 통해
            양쪽에 전달합니다.

            @Image(source: "diagram-app-structure.svg", alt: "창과 몰입 공간이 같은 모델을 공유하는 구조")
        }

        @Steps {
            @Step {
                `SolarSystemApp.swift` 파일을 엽니다. 여기가 앱이 시작되는 곳입니다.

                지금은 창 하나만 있는 가장 단순한 형태로 정리해 둡니다.

                @Code(name: "SolarSystemApp.swift", file: "01-01-SolarSystemApp.swift")
            }

            @Step {
                `Model`이라는 그룹을 만들고, 그 안에 `AppModel.swift` 파일을 새로 만듭니다.
                Xcode 왼쪽 파일 목록에서 **오른쪽 클릭 ▸ New File from Template**을 쓰면 됩니다.

                @Code(name: "AppModel.swift", file: "01-02-AppModel.swift")
            }

            @Step {
                `SolarSystemApp`에 몰입 공간을 추가하고, 모델을 양쪽 화면에 전달합니다.

                `immersionStyle`을 `.full`로 두면 몰입 공간이 열렸을 때 주변 현실이 완전히 가려집니다.

                @Code(name: "SolarSystemApp.swift", file: "01-03-SolarSystemApp.swift", previousFile: "01-01-SolarSystemApp.swift")
            }

            @Step {
                창에 몰입 공간을 여닫는 버튼을 놓습니다.

                여는 일과 닫는 일은 모두 시간이 걸리는 작업이라 `await`이 필요합니다. 그 사이에
                버튼을 또 누르지 못하도록 `inTransition` 상태를 씁니다.

                @Code(name: "ContentView.swift", file: "01-04-ContentView.swift")
            }
        }
    }

    @Section(title: "우주 배경 만들기") {
        @ContentAndMedia {
            전체 몰입 공간은 아무것도 없는 새까만 공간에서 시작합니다. 우주처럼 보이게 하려면
            배경을 직접 만들어야 합니다.

            방법은 간단합니다. 아주 큰 구를 만들고, 그 **안쪽 면**에 앞 챕터에서 넣은 밤하늘
            이미지를 입힌 뒤, 사람이 그 구의 한가운데에 있게 하면 됩니다.

            여기서 **엔티티(Entity)** 라는 말이 처음 나옵니다. 엔티티는 3차원 공간에 놓이는 물체
            하나를 뜻합니다. 구 하나, 행성 하나, 조명 하나가 각각 엔티티입니다. 그리고 엔티티에
            성질을 붙이는 것을 **컴포넌트(Component)** 라고 합니다. 모양과 재질을 정하는
            `ModelComponent`가 그 예입니다.

            @Image(source: "diagram-starfield.svg", alt: "안쪽에 별 이미지가 입혀진 큰 구")
        }

        @Steps {
            @Step {
                `RealityViews` 그룹을 만들고 `Starfield.swift` 파일을 추가합니다.

                `RealityView`는 SwiftUI 안에서 3차원 콘텐츠를 보여 주는 뷰입니다. 중괄호 안의
                코드는 화면이 처음 만들어질 때 한 번 실행되고, 여기서 만든 엔티티를 `content`에
                더하면 화면에 나타납니다.

                @Code(name: "Starfield.swift", file: "01-05-Starfield.swift")
            }

            @Step {
                `TextureResource(named: "Starfield")`가 앞 챕터에서 에셋 카탈로그에 넣은 이미지를 찾습니다. 이름이 다르면 여기서 앱이 멈춥니다.

                @Code(name: "Starfield.swift", file: "01-05-Starfield.swift")
            }

            @Step {
                구의 크기를 `x` 방향으로 뒤집는 부분이 핵심입니다. 이렇게 하지 않으면 이미지가
                바깥쪽을 향해서, 구 안에 있는 사람에게는 아무것도 보이지 않습니다.

                @Code(name: "Starfield.swift", file: "01-05-Starfield.swift")
            }

            @Step {
                몰입 공간에 보여 줄 내용을 담을 `SolarSystem.swift`를 만들고 별 배경을 넣습니다.

                앞으로 태양과 행성을 여기에 하나씩 쌓아 올립니다.

                @Code(name: "SolarSystem.swift", file: "01-06-SolarSystem.swift")
            }

            @Step {
                Xcode 위쪽에서 실행 대상을 **Apple Vision Pro 시뮬레이터**로 고르고
                **Command + R**로 실행합니다. 창의 버튼을 누르면 사방이 별로 둘러싸입니다.

                > Note: 이 챕터까지는 시뮬레이터만으로 충분히 확인할 수 있습니다.

                @Image(source: "app-starfield.png", alt: "시뮬레이터에서 별 배경이 보이는 화면")
            }
        }
    }

    @Section(title: "막히면 확인하세요") {
        @ContentAndMedia {
            이 챕터에서 자주 겪는 문제입니다.
        }

        @Steps {
            @Step {
                **버튼을 눌러도 아무 일이 없습니다.** `ImmersiveSpace(id:)`에 쓴 이름과
                `openImmersiveSpace(id:)`에 넘긴 이름이 같은지 확인하세요. 둘 다
                `model.immersiveSpaceID`를 쓰면 실수를 막을 수 있습니다.
            }

            @Step {
                **사방이 새까맣습니다.** 별 이미지 이름이 에셋 카탈로그의 이름과 다르거나,
                구를 뒤집는 줄이 빠졌을 수 있습니다. 이미지가 바깥쪽을 향하면 안에서는 보이지 않습니다.
            }

            @Step {
                **시뮬레이터에서 주변을 둘러볼 수 없습니다.** 시뮬레이터 화면을 마우스로 끌면
                고개를 돌리는 것과 같은 효과가 납니다. 오른쪽 아래 조작 아이콘으로 이동 방식을
                바꿀 수도 있습니다.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            별 배경을 만들 때 구의 `scale`에 `x: -1`을 곱하는 이유는 무엇일까요?

            @Choice(isCorrect: false) {
                구를 더 크게 만들기 위해서입니다.

                @Justification {
                    크기는 `generateSphere(radius:)`로 정합니다. 음수는 크기가 아니라 방향을 뒤집습니다.
                }
            }

            @Choice(isCorrect: true) {
                표면의 이미지가 구의 안쪽을 향하게 하려고 뒤집는 것입니다.

                @Justification {
                    맞습니다. 사람이 구의 안에 있으므로 이미지도 안쪽을 향해야 보입니다.
                }
            }

            @Choice(isCorrect: false) {
                별이 좌우로 움직이게 하려고 쓰는 것입니다.

                @Justification {
                    `scale`은 크기와 방향만 바꿀 뿐, 움직임을 만들지 않습니다.
                }
            }
        }

        @MultipleChoice {
            `AppModel`에 `inTransition` 상태를 따로 둔 이유는 무엇일까요?

            @Choice(isCorrect: false) {
                몰입 공간이 열리는 애니메이션을 만들기 위해서입니다.

                @Justification {
                    전환 효과는 시스템이 알아서 처리합니다. 이 값은 앱의 상태를 나타낼 뿐입니다.
                }
            }

            @Choice(isCorrect: true) {
                여닫는 데 시간이 걸리는 동안 버튼이 또 눌리는 일을 막기 위해서입니다.

                @Justification {
                    맞습니다. 여닫기는 `await`이 필요한 작업이라 그 사이에 입력이 또 들어올 수 있습니다.
                }
            }

            @Choice(isCorrect: false) {
                창과 몰입 공간을 동시에 띄우기 위해서입니다.

                @Justification {
                    창과 몰입 공간은 원래 함께 떠 있을 수 있습니다. 상태 값과는 관계가 없습니다.
                }
            }
        }
    }
}
