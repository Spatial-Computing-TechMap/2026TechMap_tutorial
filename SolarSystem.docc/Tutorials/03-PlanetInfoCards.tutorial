@Tutorial(time: 15) {
    @Intro(title: "Planet Info Cards") {
        Replace the placeholder label from the previous chapter with `PlanetCardContent`: a view that loads each planet's real 3D model and reveals an info card when tapped.
    }

    @Section(title: "Load the planet's 3D model") {
        @ContentAndMedia {
            `WorldAssets` is the local Reality Composer Pro package you created and linked in Chapter 1 — it isn't a system framework. Importing that module exposes `worldAssetsBundle`, and `Model3D` uses the bundle to load a named entity asynchronously while showing a placeholder.
        }

        @Steps {
            @Step {
                Create `PlanetCardContent.swift` in `RealityViews/` with a `name` and `scale` passed in from the caller. Import `WorldAssets` along with SwiftUI and RealityKit.

                If `import WorldAssets` doesn't compile, return to **Add the WorldAssets package and 3D models** in Chapter 1 and verify that the local package's library product is linked to the **SolarSystem** app target.

                @Code(file: 03-01-PlanetCardContent.swift, name: "PlanetCardContent.swift")
            }

            @Step {
                Load the model with `Model3D(named:bundle:)`, using the planet's name to look it up in the `WorldAssets` bundle and a `ProgressView` as the placeholder. Size it using `scale`, the value `PlanetConfiguration.scale(...)` computed in the previous chapter.

                @Code(file: 03-02-PlanetCardContent.swift, name: "PlanetCardContent.swift", previousFile: 03-01-PlanetCardContent.swift)
            }
        }
    }

    @Section(title: "Toggle an info card on tap") {
        @ContentAndMedia {
            Tapping the model reveals a card with the planet's name and a short description, pulled from `PlanetInfo`.
        }

        @Steps {
            @Step {
                Still in `PlanetCardContent.swift`, add an `isCardShown` state property and an `onTapGesture` on the model that toggles it.

                @Code(file: 03-03-PlanetCardContent.swift, name: "PlanetCardContent.swift", previousFile: 03-02-PlanetCardContent.swift)
            }

            @Step {
                Look up the planet's heading and description with `PlanetInfo.info(for:)`, and show them in an `HStack` alongside the model, with the text itself laid out in a `VStack` with `.glassBackgroundEffect()`, when `isCardShown` is `true`.

                @Code(file: 03-04-PlanetCardContent.swift, name: "PlanetCardContent.swift", previousFile: 03-03-PlanetCardContent.swift)
            }

            @Step {
                Swap the plain `HStack` for `HStackLayout().depthAlignment(.center)` so the flat card's depth is centered against the model's `.frame(depth:)` volume instead of defaulting to zero depth. This is the completed file.

                @Code(file: 03-05-PlanetCardContent.swift, name: "PlanetCardContent.swift", previousFile: 03-04-PlanetCardContent.swift)
            }
        }
    }

    @Section(title: "Wire it into the solar system") {
        @ContentAndMedia {
            The last step is swapping the `Text` placeholder in `SolarSystem`'s attachments closure for `PlanetCardContent`, passing each planet's computed scale.
        }

        @Steps {
            @Step {
                In `SolarSystem`, replace the placeholder `Attachment` content with `PlanetCardContent(name:scale:)`, passing `planet.scale(worldRadiusPerKm:minWorldRadius:maxWorldRadius:)` from `AppModel`. This finished file also updates `model.immersiveSpaceState` and `model.isShowingSolar`, and posts an accessibility announcement when the space appears and disappears — those two properties are the ones you declared in Chapter 1.

                @Code(file: 03-06-SolarSystem.swift, name: "SolarSystem.swift", previousFile: 02-07-SolarSystem.swift)
            }

            @Step {
                Build and run. Enter the immersive space, tap any planet, and confirm its info card appears beside it and toggles off on a second tap.
            }
        }
    }
}
